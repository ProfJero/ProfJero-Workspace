        && (d.measureKind is string && d.measureKind in ['milestones', 'numeric', 'tasks'])
        && (d.measureTarget is number && d.measureTarget >= 0 && d.measureTarget <= 1000000000)
        && (d.measureCurrent is number && d.measureCurrent >= 0 && d.measureCurrent <= 1000000000)
        && (d.measureUnit is string && d.measureUnit.size() <= 30)
        && (d.why is string && d.why.size() <= 2000)
;
    }

    function valid_milestones(d) {
      return d.keys().hasOnly(['goalId', 'title', 'dueDate', 'done', 'doneOn', 'order', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['goalId', 'title', 'dueDate', 'done', 'doneOn', 'order', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.goalId is string && d.goalId.matches('^[A-Za-z0-9_-]{1,128}$'))
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 160)
        && ((d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.dueDate == null)
        && d.done is bool
        && ((d.doneOn is string && d.doneOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.doneOn == null)
        && (d.order is int && d.order >= 0 && d.order <= 10000)
;
    }

    function valid_notes(d) {
      return d.keys().hasOnly(['title', 'body', 'category', 'tags', 'pinned', 'links', 'meeting', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'body', 'category', 'tags', 'pinned', 'links', 'meeting', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 200)
        && (d.body is string && d.body.size() <= 100000)
        && (d.category is string && d.category in ['general', 'meeting', 'idea', 'research', 'study', 'personal', 'work'])
        && (d.tags is list && d.tags.size() <= 20)
        && d.pinned is bool
        && (d.links is map && d.links.keys().hasOnly(['projectId', 'goalId', 'taskId', 'clientId', 'courseId']) && d.links.keys().hasAll(['projectId', 'goalId', 'taskId', 'clientId', 'courseId']) && ((d.links.projectId is string && d.links.projectId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.projectId == null) && ((d.links.goalId is string && d.links.goalId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.goalId == null) && ((d.links.taskId is string && d.links.taskId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.taskId == null) && ((d.links.clientId is string && d.links.clientId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.clientId == null) && ((d.links.courseId is string && d.links.courseId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.courseId == null))
        && ((d.meeting is map && d.meeting.keys().hasOnly(['date', 'attendees', 'agenda', 'actionItems']) && d.meeting.keys().hasAll(['date', 'attendees', 'agenda', 'actionItems']) && ((d.meeting.date is string && d.meeting.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.meeting.date == null) && (d.meeting.attendees is list && d.meeting.attendees.size() <= 50) && (d.meeting.agenda is string && d.meeting.agenda.size() <= 5000) && (d.meeting.actionItems is list && d.meeting.actionItems.size() <= 50)) || d.meeting == null)
;
    }

    function valid_events(d) {
      return d.keys().hasOnly(['title', 'description', 'kind', 'allDay', 'start', 'end', 'location', 'links', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'description', 'kind', 'allDay', 'start', 'end', 'location', 'links', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 200)
        && (d.description is string && d.description.size() <= 5000)
        && (d.kind is string && d.kind in ['event', 'meeting', 'reminder', 'study', 'deadline'])
        && d.allDay is bool
        && (d.start is string && d.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$'))
        && (d.end is string && d.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$'))
        && (d.location is string && d.location.size() <= 200)
        && (d.links is map && d.links.keys().hasOnly(['projectId', 'goalId', 'taskId', 'clientId', 'courseId']) && d.links.keys().hasAll(['projectId', 'goalId', 'taskId', 'clientId', 'courseId']) && ((d.links.projectId is string && d.links.projectId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.projectId == null) && ((d.links.goalId is string && d.links.goalId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.goalId == null) && ((d.links.taskId is string && d.links.taskId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.taskId == null) && ((d.links.clientId is string && d.links.clientId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.clientId == null) && ((d.links.courseId is string && d.links.courseId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.links.courseId == null))
;
    }

    function valid_courses(d) {
      return d.keys().hasOnly(['title', 'provider', 'url', 'status', 'level', 'totalUnits', 'completedUnits', 'goalId', 'targetDate', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'provider', 'url', 'status', 'level', 'totalUnits', 'completedUnits', 'goalId', 'targetDate', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 200)
        && (d.provider is string && d.provider.size() <= 120)
        && (d.url == '' || (d.url is string && d.url.size() <= 500 && d.url.matches('^https?:')))
        && (d.status is string && d.status in ['planned', 'in_progress', 'paused', 'completed'])
        && (d.level is string && d.level in ['beginner', 'intermediate', 'advanced'])
        && (d.totalUnits is int && d.totalUnits >= 0 && d.totalUnits <= 10000)
        && (d.completedUnits is int && d.completedUnits >= 0 && d.completedUnits <= 10000)
        && ((d.goalId is string && d.goalId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.goalId == null)
        && ((d.targetDate is string && d.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.targetDate == null)
        && (d.notes is string && d.notes.size() <= 5000)
;
    }

    function valid_studySessions(d) {
      return d.keys().hasOnly(['date', 'minutes', 'courseId', 'documentId', 'topic', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['date', 'minutes', 'courseId', 'documentId', 'topic', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.minutes is int && d.minutes >= 1 && d.minutes <= 1440)
        && ((d.courseId is string && d.courseId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.courseId == null)
        && ((d.documentId is string && d.documentId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.documentId == null)
        && (d.topic is string && d.topic.size() <= 200)
        && (d.notes is string && d.notes.size() <= 5000)
;
    }

    function valid_documents(d) {
      return d.keys().hasOnly(['title', 'fileName', 'contentType', 'sizeBytes', 'storagePath', 'textPath', 'pageCount', 'wordCount', 'status', 'courseId', 'position', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'fileName', 'contentType', 'sizeBytes', 'storagePath', 'textPath', 'pageCount', 'wordCount', 'status', 'courseId', 'position', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 200)
        && (d.fileName is string && d.fileName.size() >= 1 && d.fileName.size() <= 200)
        && (d.contentType is string && d.contentType in ['application/pdf', 'text/plain', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'])
