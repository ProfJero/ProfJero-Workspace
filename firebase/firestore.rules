rules_version = '2';

// Tenant isolation model
// ──────────────────────
// Every tenant-owned document lives under tenants/{tenantId}/…; access is
// granted only to users with an ACTIVE membership document at
// tenants/{tenantId}/members/{uid}. Membership documents are written only by
// Cloud Functions, so a client can never grant itself access or a role.
// Nothing here trusts tenantId/userId/role values sent in a request body.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isActiveMember(tenantId) {
      return signedIn() && exists(memberPath(tenantId)) && get(memberPath(tenantId)).data.status == 'active';
    }

    function hasPerm(tenantId, roles) {
      return isActiveMember(tenantId) && get(memberPath(tenantId)).data.role in roles;
