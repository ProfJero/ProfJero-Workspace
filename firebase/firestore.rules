        && (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.value is int && d.value >= 0 && d.value <= 100000)
;
    }

    function valid_clients(d) {
      return d.keys().hasOnly(['name', 'company', 'email', 'phone', 'address', 'status', 'notes', 'tags', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'company', 'email', 'phone', 'address', 'status', 'notes', 'tags', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.name is string && d.name.size() >= 1 && d.name.size() <= 120)
        && (d.company is string && d.company.size() <= 120)
