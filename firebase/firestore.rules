        && (d.clientId is string && d.clientId.matches('^[A-Za-z0-9_-]{1,128}$'))
        && (d.kind is string && d.kind in ['call', 'email', 'meeting', 'message', 'note'])
        && (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (d.summary is string && d.summary.size() >= 1 && d.summary.size() <= 2000)
;
    }

    function valid_categories(d) {
      return d.keys().hasOnly(['name', 'kind', 'defaultNature', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'kind', 'defaultNature', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.name is string && d.name.size() >= 1 && d.name.size() <= 60)
        && (d.kind is string && d.kind in ['income', 'expense'])
        && ((d.defaultNature is string && d.defaultNature in ['need', 'want', 'investment', 'obligation', 'other']) || d.defaultNature == null)
        && d.archived is bool
;
    }

    function valid_userProfile(d) {
      return d.keys().hasOnly(['displayName', 'defaultTenantId', 'theme', 'email', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'defaultTenantId', 'theme', 'email', 'createdAt', 'updatedAt'])
        && (d.displayName is string && d.displayName.size() <= 80)
        && ((d.defaultTenantId is string && d.defaultTenantId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.defaultTenantId == null)
        && (d.theme is string && d.theme in ['system', 'light', 'dark'])
;
    }

    // ── User-private data ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && valid_userProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && valid_userProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Password vault: end-to-end encrypted in the browser. The server only
      // ever stores ciphertext; the key is derived from a master password
      // that never leaves the device.
      match /vault/{itemId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['ciphertext', 'iv', 'kind', 'version', 'updatedAt'])
          && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() <= 200000
