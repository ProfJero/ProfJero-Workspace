          && request.resource.data.kind in ['login', 'card', 'note']
          && request.resource.data.version == 1
          && request.resource.data.updatedAt == request.time;
      }
      match /vaultMeta/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId && docId == 'key'
          && request.resource.data.keys().hasOnly(['salt', 'iterations', 'verifier', 'verifierIv', 'version'])
          && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
          && request.resource.data.iterations is int && request.resource.data.iterations >= 310000
          && request.resource.data.verifier is string && request.resource.data.verifier.size() <= 512
          && request.resource.data.verifierIv is string && request.resource.data.verifierIv.size() <= 64
          && request.resource.data.version == 1;
        // Changing the master password re-encrypts every item; the key record is replaced last.
        allow update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['salt', 'iterations', 'verifier', 'verifierIv', 'version'])
          && request.resource.data.iterations is int && request.resource.data.iterations >= 310000;
        allow delete: if false;
      }
    }

    // A user may list their own memberships (collection-group query on uid).
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A user may see invitations addressed to their verified email.
    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn() && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email.lower();
    }

    // ── Tenants ──────────────────────────────────────────────────────────
    match /tenants/{tenantId} {
      allow read: if isActiveMember(tenantId);
      allow write: if false; // createTenant / updateTenant functions

      match /tasks/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_tasks(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_tasks(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /projects/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_projects(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_projects(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /goals/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_goals(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_goals(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /milestones/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_milestones(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_milestones(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /notes/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_notes(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_notes(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /events/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_events(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_events(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /courses/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_courses(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_courses(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /studySessions/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_studySessions(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_studySessions(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /documents/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_documents(request.resource.data) && createMeta()
          && request.resource.data.storagePath.matches('tenants/' + tenantId + '/documents/' + docId + '/source[.](pdf|txt|docx)') && (request.resource.data.textPath == null || request.resource.data.textPath == 'tenants/' + tenantId + '/documents/' + docId + '/text.json');
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_documents(request.resource.data) && updateMeta()
          && request.resource.data.storagePath.matches('tenants/' + tenantId + '/documents/' + docId + '/source[.](pdf|txt|docx)') && (request.resource.data.textPath == null || request.resource.data.textPath == 'tenants/' + tenantId + '/documents/' + docId + '/text.json');
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /habits/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_habits(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_habits(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /habitLogs/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_habitLogs(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member'])
          && valid_habitLogs(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']) && resource.data.createdBy == request.auth.uid);
      }

      match /clients/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_clients(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_clients(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager']) && resource.data.createdBy == request.auth.uid);
      }

      match /clientInteractions/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_clientInteractions(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_clientInteractions(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager']) && resource.data.createdBy == request.auth.uid);
      }

      match /categories/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow create: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_categories(request.resource.data) && createMeta();
        allow update: if hasPerm(tenantId, ['owner', 'admin', 'manager'])
          && valid_categories(request.resource.data) && updateMeta();
        allow delete: if hasPerm(tenantId, ['owner', 'admin'])
          || (hasPerm(tenantId, ['owner', 'admin', 'manager']) && resource.data.createdBy == request.auth.uid);
      }

      match /members/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager', 'member', 'viewer']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /invitations/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /auditLogs/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /accounts/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /transactions/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /debts/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /budgets/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /savingsGoals/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /savingsContributions/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /invoices/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /paymentNotices/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /legacyArchive/{docId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin']);
        allow write: if false; // written only by Cloud Functions (Admin SDK)
      }

      match /invoices/{invoiceId}/events/{eventId} {
        allow read: if hasPerm(tenantId, ['owner', 'admin', 'manager']);
        allow write: if false;
      }

      // Idempotency records, counters and anything not listed: no client access.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── Legacy (pre-rebuild) collections ─────────────────────────────────
    // Legacy data is migrated server-side. The only client access kept is for
    // the owner to read and then delete their legacy plaintext vault entries
    // while moving them into the encrypted vault.
    match /passwords/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /secureNotes/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /paymentCards/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
