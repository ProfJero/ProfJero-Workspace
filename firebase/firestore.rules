    }

    function valid_goals(d) {
      return d.keys().hasOnly(['title', 'description', 'category', 'status', 'startDate', 'targetDate', 'measureKind', 'measureTarget', 'measureCurrent', 'measureUnit', 'why', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'description', 'category', 'status', 'startDate', 'targetDate', 'measureKind', 'measureTarget', 'measureCurrent', 'measureUnit', 'why', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 160)
