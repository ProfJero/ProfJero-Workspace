    }

    function updateMeta() {
      let d = request.resource.data;
      return d.createdBy == resource.data.createdBy && d.createdAt == resource.data.createdAt
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    function valid_tasks(d) {
      return d.keys().hasOnly(['title', 'description', 'status', 'priority', 'dueDate', 'dueTime', 'projectId', 'goalId', 'assigneeId', 'labels', 'recurrence', 'completedOn', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['title', 'description', 'status', 'priority', 'dueDate', 'dueTime', 'projectId', 'goalId', 'assigneeId', 'labels', 'recurrence', 'completedOn', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.title is string && d.title.size() >= 1 && d.title.size() <= 200)
        && (d.description is string && d.description.size() <= 5000)
        && (d.status is string && d.status in ['todo', 'in_progress', 'blocked', 'done', 'cancelled'])
        && (d.priority is string && d.priority in ['low', 'medium', 'high', 'urgent'])
        && ((d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.dueDate == null)
        && ((d.dueTime is string && d.dueTime.matches('^[0-9]{2}:[0-9]{2}$')) || d.dueTime == null)
        && ((d.projectId is string && d.projectId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.projectId == null)
        && ((d.goalId is string && d.goalId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.goalId == null)
        && ((d.assigneeId is string && d.assigneeId.matches('^[A-Za-z0-9_-]{1,128}$')) || d.assigneeId == null)
        && (d.labels is list && d.labels.size() <= 20)
        && ((d.recurrence is map && d.recurrence.keys().hasOnly(['frequency', 'interval']) && d.recurrence.keys().hasAll(['frequency', 'interval']) && (d.recurrence.frequency is string && d.recurrence.frequency in ['daily', 'weekly', 'monthly']) && (d.recurrence.interval is int && d.recurrence.interval >= 1 && d.recurrence.interval <= 365)) || d.recurrence == null)
        && ((d.completedOn is string && d.completedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.completedOn == null)
;
    }

    function valid_projects(d) {
      return d.keys().hasOnly(['name', 'description', 'status', 'priority', 'startDate', 'deadline', 'clientId', 'goalId', 'memberIds', 'budgetMinor', 'progressMode', 'manualProgress', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'description', 'status', 'priority', 'startDate', 'deadline', 'clientId', 'goalId', 'memberIds', 'budgetMinor', 'progressMode', 'manualProgress', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && (d.name is string && d.name.size() >= 1 && d.name.size() <= 120)
        && (d.description is string && d.description.size() <= 5000)
        && (d.status is string && d.status in ['planning', 'active', 'on_hold', 'completed', 'cancelled'])
        && (d.priority is string && d.priority in ['low', 'medium', 'high', 'urgent'])
        && ((d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.startDate == null)
        && ((d.deadline is string && d.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) || d.deadline == null)
