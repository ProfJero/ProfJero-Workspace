    function valid_habits(d) {
      return d.keys().hasOnly(['name', 'frequency', 'target', 'unit', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'frequency', 'target', 'unit', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
