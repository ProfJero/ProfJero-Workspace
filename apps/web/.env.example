VITE_FIREBASE_API_KEY=AIzaSyDSvTre5jtA1CqsbxqLSsJ4n0OBvX4BCqo
VITE_FIREBASE_AUTH_DOMAIN=profjero.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=profjero
VITE_FIREBASE_STORAGE_BUCKET=profjero.firebasestorage.app
VITE_FIREBASE_APP_ID=1:950791554195:web:412f915845fbc84634f966
