# Set to "true" to use the local Firebase emulators (npm run emulators).
VITE_USE_EMULATORS=false
# Optional App Check (reCAPTCHA Enterprise) site key. Recommended in production.
VITE_APPCHECK_SITE_KEY=

# URL of the Cloudflare Worker API. When set, EVERY server operation goes to the Worker
# (when empty, the app falls back to Firebase Functions). It is also written into the
# Content-Security-Policy generated for Cloudflare Pages at build time.
# Local: http://127.0.0.1:8787   Production: https://profjero-workspace-api.<your-subdomain>.workers.dev
VITE_WORKER_URL=